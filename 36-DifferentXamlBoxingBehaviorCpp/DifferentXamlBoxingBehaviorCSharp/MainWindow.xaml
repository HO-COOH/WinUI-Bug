<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DifferentXamlBoxingBehaviorCSharp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:component="using:RuntimeComponent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DifferentXamlBoxingBehaviorCSharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DifferentXamlBoxingBehaviorCSharp"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch">
        <Grid.Resources>
            <component:ViewModel x:Name="MyViewModel">
                <component:ViewModel.EnumProperty>
                    <component:ContentAlignment>Right</component:ContentAlignment>
                </component:ViewModel.EnumProperty>
            </component:ViewModel>
        </Grid.Resources>
    </Grid>
</Window>
