<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="_35_xBindToFunction.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:_35_xBindToFunction"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="35-xBindToFunction"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <local:ViewModel x:Name="ViewModel" />
        </Grid.Resources>

        <!--  This works directly  -->
        <!--<Button Content="{x:Bind ViewModel.MyProperty}" />-->

        <!--  This requires to declare ViewModel in idl  -->
        <Button Click="{x:Bind ViewModel.Print}" Content="Some content" />
    </Grid>
</Window>
